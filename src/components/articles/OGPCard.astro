---
import { getOgp } from '@/lib/ogp';

interface Props {
  url: string;
}

const { url } = Astro.props;
const ogp = getOgp(url);
---
{ogp ? (
  <div class="my-6">
    <a href={ogp.url || url} target="_blank" rel="noopener noreferrer" class="group flex h-36 max-w-full overflow-hidden rounded-lg border border-line bg-card-background shadow-xs no-underline hover:border-accent hover:shadow-md">
      {ogp.image && (
        <div class="w-48 shrink-0">
          <img src={ogp.image} alt="" class="h-full w-full object-cover object-center" />
        </div>
      )}
      <div class="flex flex-1 flex-col justify-center p-4 overflow-hidden">
        <div class="truncate font-bold text-text-body underline group-hover:decoration-2">{ogp.title || url}</div>
        <div class="mt-1 text-scale--1 text-text-body line-clamp-1">{ogp.description || ''}</div>
        <div class="mt-auto truncate pt-1 text-scale--1 text-text-note">{ogp.siteName || new URL(url).hostname}</div>
      </div>
    </a>
  </div>
) : (
  <p>
    <a href={url} target="_blank" rel="noopener noreferrer" class="text-link underline hover:decoration-2">{url}</a>
    <br />
    <em>(OGP情報の取得に失敗しました)</em>
  </p>
)}
