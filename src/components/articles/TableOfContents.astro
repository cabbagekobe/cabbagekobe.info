---
import type { MarkdownHeading } from 'astro';
import { buildTocTree } from '@/lib/content/toc';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const tocTree = buildTocTree(headings);
---

{
  tocTree.length > 0 && (
    <nav aria-label="目次" class="p-4 border border-line rounded-lg bg-card-background mb-8">
      <h2 class="text-scale-1 font-bold mb-4">目次</h2>
      <ul class="text-scale--1">
        {tocTree.map((item) => (
          <li>
            <a href={`#${item.slug}`} class="underline hover:decoration-2">{item.text}</a>
            {item.children.length > 0 && (
              <ul class="pl-4 my-1">
                {item.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`} class="underline hover:decoration-2">{child.text}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}
