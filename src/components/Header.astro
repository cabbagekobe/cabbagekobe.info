---
import { siteConfig } from '@/site.config';
---
<header
  class="sticky top-0 z-40 w-full bg-background border-b border-line shadow-xs"
>
  <div
    class:list={[
      'mx-auto',
      'flex',
      'h-16',
      siteConfig.layout.width,
      'items-center',
      'justify-between',
      'px-3',
    ]}
  >
    <h1 class="font-bold text-scale-2">
      <a href="/" class="underline hover:decoration-2">{siteConfig.title}</a>
    </h1>
  </div>
</header>

