---
import type { Article } from '@/lib/content/types';
import { formatDate } from '@/lib/content/utils';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const fm = article.data;
---
<article class="flex flex-row overflow-hidden">
  <div class="flex flex-1 flex-col pb-4">
    <h2 class="mb-2 text-scale-2 font-bold">
      <a href={article.permalink} class="underline hover:decoration-2">{fm.title}</a>
    </h2>

    <div class="mb-3 text-scale--1 text-text-note">
      <time datetime={fm.published_at.toISOString()}>{formatDate(fm.published_at)}</time>
    </div>

    {fm.summary && (
      <p class="mb-4 text-scale-0 line-clamp-2">{fm.summary}</p>
    )}
  </div>
</article>
