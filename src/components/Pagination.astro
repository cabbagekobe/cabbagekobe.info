---
import type { Page } from 'astro';
import type { Article } from '@/lib/content/types';

interface Props {
  page: Page<Article>;
}

const { page } = Astro.props;
---

<nav aria-label="ページ送り" class="flex justify-center gap-8 text-scale--1">
  {page.url.prev && (
    <a href={page.url.prev} class="underline hover:decoration-2">
      &laquo; 前のページ
    </a>
  )}
  {page.url.next && (
    <a href={page.url.next} class="underline hover:decoration-2">
      次のページ &raquo;
    </a>
  )}
</nav>
