---
import type { GetStaticPaths, Page } from 'astro';
import ArticleListLayout from '@/layouts/ArticleListLayout.astro';
import { HOME_LABEL } from '@/lib/constants';
import { getAllArticles, sortByPublishedDesc } from '@/lib/content/articles';
import { isArticleVisible } from '@/lib/content/filters';
import type { Article } from '@/lib/content/types';
import { siteConfig } from '@/site.config';

export const getStaticPaths = (async ({ paginate }) => {
  if (import.meta.env.PROD) {
    return [];
  }

  const allArticles = await getAllArticles();

  const previewArticles = sortByPublishedDesc(
    allArticles.filter((a) => !isArticleVisible(a.data)),
  );

  return paginate(previewArticles, { pageSize: siteConfig.articlesPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Article>;
}

const { page } = Astro.props;
const title = '下書き・未来記事一覧';
const description = '現在公開されていない記事の一覧です。';
const crumbs = [{ label: HOME_LABEL, href: '/' }, { label: 'Drafts' }];
---

<ArticleListLayout
  title={title}
  description={description}
  articles={page.data}
  crumbs={crumbs}
  page={page}
  permalink={Astro.url.pathname}
  noindex={true}
/>
