---
import ArticleListLayout from '@/layouts/ArticleListLayout.astro';
import { HOME_LABEL } from '@/lib/constants';
import { getAllPublishedArticles } from '@/lib/content/articles';
import { siteConfig } from '@/site.config';

const allArticles = await getAllPublishedArticles();
const items = allArticles.slice(0, siteConfig.articlesPerPage);
const title = siteConfig.title;

const crumbs = [{ label: HOME_LABEL }];
---
<ArticleListLayout
  title={title}
  articles={items}
  crumbs={crumbs}
  permalink="/"
/>
