---
import type { GetStaticPaths, Page } from 'astro';
import ArticleListLayout from '@/layouts/ArticleListLayout.astro';
import { HOME_LABEL } from '@/lib/constants';
import { getAllPublishedArticles } from '@/lib/content/articles';
import type { Article } from '@/lib/content/types';
import { siteConfig } from '@/site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const publishedArticles = await getAllPublishedArticles();
  return paginate(publishedArticles, { pageSize: siteConfig.articlesPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Article>;
}

const { page } = Astro.props;
const title = `記事一覧 - ${siteConfig.title}`;
const crumbs = [{ label: HOME_LABEL, href: '/' }, { label: '記事一覧' }];
---
<ArticleListLayout
  title={title}
  articles={page.data}
  crumbs={crumbs}
  page={page}
  permalink={Astro.url.pathname}
/>
