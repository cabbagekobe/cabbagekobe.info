---
import { render } from 'astro:content';
import OGPCard from '@/components/articles/OGPCard.astro';
import RelatedArticles from '@/components/articles/RelatedArticles.astro';
import TableOfContents from '@/components/articles/TableOfContents.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Base from '@/layouts/Base.astro';
import { HOME_LABEL } from '@/lib/constants';
import { getArticlesToBuild, getRelatedArticles } from '@/lib/content/articles';
import type { Article } from '@/lib/content/types';
import { formatDate } from '@/lib/content/utils';
import type { Crumb } from '@/lib/schema';
import { createArticleSchema, createBreadcrumbSchema } from '@/lib/schema';
import { siteConfig } from '@/site.config';

export async function getStaticPaths() {
  const articlesToBuild = await getArticlesToBuild();

  return articlesToBuild.map((currentArticle) => ({
    params: { slug: currentArticle.id },
    props: { article: currentArticle, allArticles: articlesToBuild },
  }));
}

interface Props {
  article: Article;
  allArticles: Article[];
}

const { article, allArticles } = Astro.props;
const { data } = article;

const { title, summary, meta_title, meta_description, cover_image } = data;

const crumbs: Crumb[] = [{ href: '/', label: HOME_LABEL }, { label: title }];

// TOCの取得
const { Content, headings } = await render(article);

const related = getRelatedArticles(article, allArticles);

const articleSchema = createArticleSchema(article, siteConfig);
const breadcrumbSchema = createBreadcrumbSchema(crumbs, siteConfig.siteUrl);
const schemas = [articleSchema, breadcrumbSchema];
---

<Base
  title={meta_title ?? title}
  description={meta_description ?? summary}
  permalink={article.permalink}
  og={{
    type: 'article',
    image: cover_image,
    publishedTime: data.published_at.toISOString(),
    modifiedTime: (
      data.updated_at ?? data.published_at
    ).toISOString(),
  }}
  schemas={schemas}
>
  <Breadcrumb crumbs={crumbs} />

  <article>
    <div class="mb-12">
      <h1 class="text-scale-3 font-extrabold mb-4 leading-tight">{title}</h1>

      {
        cover_image && (
          <figure class="mb-4">
            <img
              src={cover_image.src}
              width={cover_image.width}
              height={cover_image.height}
              alt={title}
              class="w-full h-auto rounded-lg"
            />
            {data.cover_caption && (
              <figcaption class="mt-2 text-scale-0 text-center text-text-note">
                {data.cover_caption}
              </figcaption>
            )}
          </figure>
        )
      }

      <div class="article-meta flex items-center text-scale--1 text-text-note">
        <time datetime={data.published_at.toISOString()} class="mr-3">
          {formatDate(data.published_at)}
        </time>
      </div>
      {summary && <p class="text-scale--1 text-text-note my-6">{summary}</p>}

      {/* TOCを記事コンテンツの直前に配置 */}
      {data.show_toc && <TableOfContents headings={headings} />}
    </div>

    {/* MDXコンテンツのレンダリング */}
    <div class="article-content">
      <Content components={{ OGPCard }} />
    </div>
  </article>

  <RelatedArticles related={related} />
</Base>
