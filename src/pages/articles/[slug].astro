---
import { render } from 'astro:content';
import OGPCard from '@/components/articles/OGPCard.astro';
import RelatedArticles from '@/components/articles/RelatedArticles.astro';
import TableOfContents from '@/components/articles/TableOfContents.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Base from '@/layouts/Base.astro';
import { HOME_LABEL } from '@/lib/constants';
import { getAllArticles, getRelatedArticles } from '@/lib/content/articles';
import { isArticleVisible } from '@/lib/content/filters';
import type { Article } from '@/lib/content/types';
import {
  formatDate,
  getEntrySlug,
  resolveCoverImagePath,
} from '@/lib/content/utils';
import { createArticleSchema, createBreadcrumbSchema } from '@/lib/schema';
import { siteConfig } from '@/site.config';

export async function getStaticPaths() {
  const allArticles = await getAllArticles();

  const articlesToBuild = import.meta.env.PROD
    ? allArticles.filter(({ data }) => isArticleVisible(data))
    : allArticles;

  return articlesToBuild.map((currentArticle) => {
    const articleSlug = getEntrySlug(currentArticle.id);
    return {
      params: { slug: articleSlug },
      props: { article: currentArticle, allArticles: articlesToBuild },
    };
  });
}

interface Props {
  article: Article;
  allArticles: Article[];
}

const { article, allArticles } = Astro.props;
const { data } = article;
const slug = getEntrySlug(article.id);

// Safely extract data properties with defaults
const {
  title = 'Untitled',
  summary = '',
  meta_title,
  meta_description,
  published_at,
  updated_at,
  cover_image,
  cover_caption,
  show_toc = false,
} = data;

const crumbs = [{ href: '/', label: HOME_LABEL }];
crumbs.push({ label: title });

// カバー画像のパスを解決
const coverSrc = resolveCoverImagePath(cover_image, slug);

// TOCの取得
const { Content, headings } = await render(article);

if (import.meta.env.PROD && !isArticleVisible(data)) {
  return Astro.redirect('/404');
}

const related = getRelatedArticles(article, allArticles);

const articleSchema = createArticleSchema(
  article,
  Astro.url.origin,
  siteConfig,
);
const breadcrumbSchema = createBreadcrumbSchema(crumbs, Astro.url.origin);
const schemas = [articleSchema, breadcrumbSchema].filter(Boolean);
---

<Base
  title={meta_title ?? title ?? 'Article'}
  description={meta_description ?? summary}
  permalink={article.permalink}
  og={{
    type: 'article',
    image: coverSrc,
    publishedTime: data.published_at.toISOString(),
    modifiedTime: (
      data.updated_at ?? data.published_at
    ).toISOString(),
  }}
  schemas={schemas}
>
  <Breadcrumb crumbs={crumbs} />

  <article>
    <div class="mb-12">
      <h1 class="text-scale-3 font-extrabold mb-4 leading-tight">{title}</h1>

      {
        coverSrc && (
          <figure class="mb-4">
            <img
              src={coverSrc}
              alt={meta_title ?? title ?? ''}
              loading="lazy"
              class="w-full h-auto rounded-lg"
            />
            {data.cover_caption && (
              <figcaption class="mt-2 text-scale-0 text-center text-text-body/80">
                {data.cover_caption}
              </figcaption>
            )}
          </figure>
        )
      }

      <div class="article-meta flex items-center text-scale--1 text-text-body/70">
        {
          data.published_at && (
            <time datetime={data.published_at.toISOString()} class="mr-3">
              {formatDate(data.published_at)}
            </time>
          )
        }
      </div>
      {summary && <p class="text-scale--1 text-text-body/90 my-6">{summary}</p>}

      {/* TOCを記事コンテンツの直前に配置 */}
      {headings && headings.length > 0 && data.show_toc === true && (
        <TableOfContents headings={headings} />
      )}
    </div>

    {/* MDXコンテンツのレンダリング */}
    <div class="article-content">
      <Content
          components={{
          OGPCard
          }}
        />
    </div>
  </article>

  <RelatedArticles related={related} />
</Base>
