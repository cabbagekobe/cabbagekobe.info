---
import { getCollection, render } from 'astro:content';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Base from '@/layouts/Base.astro';
import { HOME_LABEL } from '@/lib/constants';
import { createBreadcrumbSchema, createWebPageSchema } from '@/lib/schema';
import { siteConfig } from '@/site.config';

const pages = await getCollection('pages');
const aboutEntry = pages.find((entry) => entry.id === 'about');

if (!aboutEntry) {
  throw new Error('About page content not found.');
}

const { data } = aboutEntry;
const title = data.title;
const description = data.summary;
const permalink = '/about/';

const crumbs = [{ label: HOME_LABEL, href: '/' }, { label: data.title }];

const webPageSchema = createWebPageSchema(
  { title, description, permalink },
  siteConfig.siteUrl,
);
const breadcrumbSchema = createBreadcrumbSchema(crumbs, siteConfig.siteUrl);

const schemas = [webPageSchema, breadcrumbSchema];

const { Content } = await render(aboutEntry);
---

<Base
  title={title}
  description={description}
  permalink={permalink}
  schemas={schemas}
>
  <Breadcrumb crumbs={crumbs} />

  <h1 class="text-scale-3 font-extrabold mb-4 leading-tight">{title}</h1>

  <div class="article-content">
    <Content />
  </div>
</Base>
