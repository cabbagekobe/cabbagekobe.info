---
import { getCollection, render } from 'astro:content';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Base from '@/layouts/Base.astro';
import { HOME_LABEL } from '@/lib/constants';
import { createBreadcrumbSchema } from '@/lib/schema';

const pages = await getCollection('pages');
const aboutEntry = pages.find(
  (entry) => entry.id.startsWith('about') && !entry.id.includes('/'),
);

if (!aboutEntry) {
  throw new Error('About page content not found.');
}

const { data } = aboutEntry;
const title = data.title;
const description = data.summary;

const crumbs = [{ label: HOME_LABEL, href: '/' }, { label: data.title }];

const webPageSchema = {
  '@type': 'WebPage',
  '@id': Astro.url.href,
  name: title,
  description: description,
  url: Astro.url.href,
};
const breadcrumbSchema = createBreadcrumbSchema(crumbs, Astro.url.origin);

const schemas = [webPageSchema, breadcrumbSchema];

const { Content } = await render(aboutEntry);
---

<Base title={title} description={description} schemas={schemas}>
  <Breadcrumb crumbs={crumbs} />

  <div class="article-content">
    <Content />
  </div>
</Base>
