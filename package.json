{
  "name": "favolight-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prebuild && astro dev",
    "prebuild": "node src/scripts/fetch-ogp.mjs",
    "build": "astro build",
    "preview": "npm run prebuild && astro preview",
    "clean": "rimraf dist .astro",
    "new:article": "tsx src/scripts/new-article.ts",
    "format": "npx @biomejs/biome format --write .",
    "lint": "npx @biomejs/biome check --write .",
    "list:routes": "tsx src/scripts/list-all-routes.ts",
    "screenshot:pages": "tsx src/scripts/screenshot-pages.ts",
    "start": "npm run dev",
    "test": "vitest --run",
    "check-all": "astro build && npm run lint && npm run test"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@biomejs/biome": "^2.4.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/prompts": "^2.4.9",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.0.4",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "marked": "^18.0.5",
    "playwright": "^1.58.2",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@playform/compress": "^0.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "open-graph-scraper": "^6.11.0",
    "rehype-slug": "^6.0.0"
  }
}
